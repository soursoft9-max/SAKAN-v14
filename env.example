# انسخي هذا الملف باسم .env وعبّئي القيم

# من Supabase > Project Settings > API (نفس القيم الموجودة في main.js)
SUPABASE_URL=https://qvctiztgjcjtpaezfrck.supabase.co
SUPABASE_ANON_KEY=ضعي_المفتاح_العام_هنا

# حساب أمن مخصص للربط تنشئه الإدارة من صفحة الحسابات (نوع الحساب: أمن)
